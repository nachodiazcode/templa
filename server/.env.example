# Copia este archivo a .env y ajusta los valores.
# Sin .env la app funciona en modo local (JSON + secrets de desarrollo).

# Frontend y servidor
APP_URL=http://localhost:4300
SERVER_URL=http://localhost:8787
PORT=8787
# Orígenes CORS adicionales, separados por coma (la app y el server van siempre permitidos)
ALLOWED_ORIGINS=

# Autenticación (¡define JWT_SECRET real en producción!)
JWT_SECRET=
JWT_TTL=7d

# Correo (opcional; sin SMTP los correos de cumplimiento se guardan en server/data/outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Templa <hola@templa.app>

# Supabase (opcional; sin estas credenciales se usa persistencia en JSON local)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Webpay Plus (integración usa credenciales públicas de prueba)
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=